    "SWOT_L3_LR_WIND_WAVE": {
      "description": "SWOT Level 3 Low-Rate Wind and Wave spectral products from KaRIn",
      "ftp_path": "l3_karin/l3_lr_wind_wave",
      "versions": ["v2_0"],
      "variants": ["Extended", "Light"],
      "note": "Contains spectral data in HDF5 groups (tile_5km, tile_10km)",
      "dimensions": {
        "nfy": "frequency bins in along-track",
        "nfx": "frequency bins in cross-track",
        "nphi": "azimuthal bins",
        "nf": "frequency vector length"
      },
      "groups": ["tile_5km", "tile_10km"],
      "variables": {
        "filter_PTR": {
          "long_name": "instrumental filter, KaRIn azimuthal PTR",
          "units": "m^2.m^2",
          "group": "tile_5km/tile_10km"
        },
        "filter_OBP": {
          "long_name": "instrumental filter, KaRIn OBP averaging",
