{
  "_metadata": {
    "description": "AVISO SWOT product variable catalog",
    "ftp_base_path": "/swot_products",
    "last_updated": "2025-11-29",
    "structure": "{level}/{product}/{version}/{variant}/cycle_{NNN}/files"
  },
  "products": {
    "SWOT_L3_LR_SSH": {
      "description": "SWOT Level 3 Low-Rate Sea Surface Height from KaRIn and Nadir",
      "ftp_path": "l3_karin_nadir/l3_lr_ssh",
      "versions": ["v1_0", "v1_0_1", "v1_0_2", "v2_0", "v2_0_1", "v3_0"],
      "variants": ["Basic", "Expert", "Unsmoothed"],
      "dimensions": {
        "num_lines": "alongtrack dimension (varies per pass)",
        "num_pixels": "acrosstrack dimension (69 for KaRIn swath)",
        "num_nadir": "nadir track dimension"
      },
      "coordinates": ["latitude", "longitude"],
      "variables": {
        "ssha": {
          "long_name": "sea surface height anomaly",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "ssha_noiseless": {
          "long_name": "sea surface height anomaly without noise",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "ssha_unedited": {
          "long_name": "sea surface height anomaly without editing",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "mdt": {
          "long_name": "mean dynamic topography",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "mss": {
          "long_name": "mean sea surface height (CNES/CLS)",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "dac": {
          "long_name": "dynamic atmospheric correction",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "ocean_tide": {
          "long_name": "geocentric ocean tide height (FES)",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "calibration": {
          "long_name": "satellite calibration",
          "units": "m",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "sigma0": {
          "long_name": "normalized radar cross section (sigma0) from KaRIn",
          "units": "1",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "ugos": {
          "long_name": "Absolute geostrophic velocity: zonal component",
          "units": "m/s",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "ugosa": {
          "long_name": "Geostrophic velocity anomalies: zonal component",
          "units": "m/s",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "vgos": {
          "long_name": "Absolute geostrophic velocity: meridian component",
          "units": "m/s",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "vgosa": {
          "long_name": "Geostrophic velocity anomalies: meridian component",
          "units": "m/s",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "float64"
        },
        "quality_flag": {
          "long_name": "Quality Flag",
          "units": "",
          "dims": ["num_lines", "num_pixels"],
          "dtype": "uint8"
        },
        "cross_track_distance": {
          "long_name": "cross track distance",
          "units": "m",
          "dims": ["num_pixels"],
          "dtype": "float64"
        },
        "time": {
          "long_name": "time in UTC",
          "units": "",
          "dims": ["num_lines"],
          "dtype": "datetime64[ns]"
        },
        "i_num_line": {
          "long_name": "alongtrack indice of the nearest karin pixel from the nadir data",
          "units": "count",
          "dims": ["num_nadir"],
          "dtype": "int16"
        },
        "i_num_pixel": {
          "long_name": "acrosstrack indice of the nearest karin pixel from the nadir data",
          "units": "count",
          "dims": ["num_nadir"],
          "dtype": "int8"
        }
      }
    },
